{
  "uid": "oci-reclamation",
  "title": "OCI Always Free reclamation",
  "description": "Oracle reclaims an Always Free instance when 7-day p95 CPU, network and memory are all under 20%. Each instance needs one of them above the line.",
  "tags": ["oci", "homelab"],
  "timezone": "browser",
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "schemaVersion": 39,
  "templating": {"list": []},
  "panels": [
    {
      "type": "stat", "title": "Memory p95 (7d)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "quantile_over_time(0.95, node:memory_used:ratio[7d])", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.2}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat", "title": "CPU p95 (7d)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "quantile_over_time(0.95, node:cpu_used:ratio[7d])", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.2}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat", "title": "Network (5m avg)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "node:network_bytes:rate5m", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "decimals": 1}, "overrides": []},
      "options": {"colorMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat", "title": "Reclamation risk", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "(quantile_over_time(0.95, node:memory_used:ratio[7d]) < bool 0.2) * on(instance) (quantile_over_time(0.95, node:cpu_used:ratio[7d]) < bool 0.2)", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "safe", "color": "green"}, "1": {"text": "AT RISK", "color": "red"}}}]}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "timeseries", "title": "Memory used", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "node:memory_used:ratio", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"thresholdsStyle": {"mode": "line+area"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 0.2}]}}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "CPU used", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "node:cpu_used:ratio", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 0.2}]}}, "overrides": []}
    }
  ]
}
