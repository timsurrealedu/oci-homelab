# Managed by Ansible (infra/ansible/roles/monitoring).
# Host networking, every listener on 127.0.0.1: scrapes reach host services directly, and the UIs are
# exposed only through Tailscale Serve (tailnet-only HTTPS). Nothing here is reachable from the internet.
name: monitoring

services:
  prometheus:
    image: prom/prometheus:{{ monitoring_versions.prometheus }}
    network_mode: host
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_retention }}
      - --web.listen-address=127.0.0.1:9090
      - --web.external-url={{ monitoring_ts_url }}:9090/
      - --web.route-prefix=/
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus

  alertmanager:
    image: prom/alertmanager:{{ monitoring_versions.alertmanager }}
    network_mode: host
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=127.0.0.1:9093
      - --web.external-url={{ monitoring_ts_url }}:9093/
      - --web.route-prefix=/
      - --cluster.listen-address=
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
      - /etc/oci-homelab/secrets/telegram_bot_token:/run/secrets/telegram_bot_token:ro
      - alertmanager-data:/alertmanager

  grafana:
    image: grafana/grafana-oss:{{ monitoring_versions.grafana }}
    network_mode: host
    restart: unless-stopped
    environment:
      GF_SERVER_HTTP_ADDR: 127.0.0.1
      GF_SERVER_HTTP_PORT: "3000"
      GF_SERVER_ROOT_URL: {{ monitoring_ts_url }}:3000/
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - /etc/oci-homelab/secrets/grafana_admin_password:/run/secrets/grafana_admin_password:ro
      - grafana-data:/var/lib/grafana

  uptime-kuma:
    image: louislam/uptime-kuma:{{ monitoring_versions.uptime_kuma }}
    network_mode: host
    restart: unless-stopped
    environment:
      UPTIME_KUMA_HOST: 127.0.0.1
      UPTIME_KUMA_PORT: "3002"
    volumes:
      - uptime-kuma-data:/app/data

volumes:
  prometheus-data:
  alertmanager-data:
  grafana-data:
  uptime-kuma-data:
