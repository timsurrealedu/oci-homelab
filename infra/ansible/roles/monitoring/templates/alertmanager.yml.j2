# Managed by Ansible (infra/ansible/roles/monitoring). Bot token is read from a file, never inlined.
route:
  receiver: telegram
  group_by: [alertname, node]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /run/secrets/telegram_bot_token
        chat_id: {{ monitoring_telegram.TELEGRAM_CHAT_ID }}
        parse_mode: HTML
        send_resolved: true
