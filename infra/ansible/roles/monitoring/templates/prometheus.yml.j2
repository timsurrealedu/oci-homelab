# Managed by Ansible (infra/ansible/roles/monitoring)
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files: [rules.yml]

alerting:
  alertmanagers:
    - static_configs: [{targets: ["127.0.0.1:9093"]}]

scrape_configs:
  - job_name: node
    static_configs:
{% for n in monitoring_node_targets %}
      - targets: ["{{ n.target }}"]
        labels: {node: {{ n.name }}}
{% endfor %}
  - job_name: prometheus
    static_configs: [{targets: ["127.0.0.1:9090"]}]
  - job_name: alertmanager
    static_configs: [{targets: ["127.0.0.1:9093"]}]
  - job_name: grafana
    static_configs: [{targets: ["127.0.0.1:3000"]}]
  - job_name: caddy
    static_configs: [{targets: ["127.0.0.1:2019"]}]
