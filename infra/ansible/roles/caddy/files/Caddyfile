# Managed by Ansible (infra/ansible/roles/caddy/files/Caddyfile).
{
	admin 127.0.0.1:2019
	metrics
	# No domain yet: plain HTTP on :80, reached through Tailscale Serve (:8443).
	# Public 80/443 stay closed at the host firewall. Remove this line once a domain points here.
	auto_https off
}

# smartStudent: SPA + API. Ported from the old nginx site (2026-11-11), same headers and caching.
:80 {
	encode gzip
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /health {
		reverse_proxy 127.0.0.1:3001
	}
	handle /sw.js {
		root * /srv/smartstudent
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	handle {
		root * /srv/smartstudent
		header Cache-Control "max-age=86400, public, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Demos (apps/<name>): Caddy serves the page from public/ and the shared UI at /ui/; only /api/* reaches the app.
# No inline scripts or styles anywhere, so the CSP can be strict. Usage: import demo <app dir name>
(demo) {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
	handle_path /ui/* {
		root * /srv/apps/_ui
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		root * /srv/apps/{args[0]}/public
		header Cache-Control "no-cache"
		file_server
	}
}

# Looking glass (apps/lg). Tailnet-only via Tailscale Serve :8446 until it becomes lg.<domain>.
:8091 {
	bind 127.0.0.1
	import demo lg
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
}

# Paper-trading dashboard (apps/trading). Tailnet-only via Tailscale Serve :8447 until it becomes trading.<domain>.
:8093 {
	bind 127.0.0.1
	import demo trading
	handle /api/* {
		reverse_proxy 127.0.0.1:8092
	}
}

# Request tracer (apps/trace). Stamps the forward time so the app can show the Caddy -> app hop.
# Tailnet-only via Tailscale Serve :8448 until it becomes trace.<domain>.
:8095 {
	bind 127.0.0.1
	import demo trace
	handle /api/* {
		reverse_proxy 127.0.0.1:8094 {
			header_up X-Trace-Caddy-In {time.now.unix_ms}
		}
	}
}
